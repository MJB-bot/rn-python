[Unit]
Description=Flask App (Enterprise Mobile)
After=network.target mysqld.service
Wants=mysqld.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/flask-app
ExecStart=/opt/flask-app/venv/bin/gunicorn -w 4 -b 0.0.0.0:5000 wsgi:app
Restart=always
RestartSec=5
StandardOutput=append:/opt/flask-app/logs/gunicorn.log
StandardError=append:/opt/flask-app/logs/gunicorn-error.log
EnvironmentFile=/opt/flask-app/.env

[Install]
WantedBy=multi-user.target
